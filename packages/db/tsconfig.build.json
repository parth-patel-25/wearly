{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",

    "module": "node16",
    "moduleResolution": "node16",
    "verbatimModuleSyntax": false,
    "isolatedModules": false,

    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"]
}
