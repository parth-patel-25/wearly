{
  "name": "@wearly/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./schema/admin-invites": {
      "types": "./dist/schema/admin-invites.d.ts",
      "default": "./dist/schema/admin-invites.js"
    },
    "./schema/auth": {
      "types": "./dist/schema/auth.d.ts",
      "default": "./dist/schema/auth.js"
    }
  },
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@wearly/tsconfig": "workspace:*",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "6.0.3"
  }
}
