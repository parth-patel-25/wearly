{
  "name": "@wearly/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api/routes": {
      "types": "./dist/api/routes.d.ts",
      "default": "./dist/api/routes.js"
    },
    "./api/schemas": {
      "types": "./dist/api/schemas.d.ts",
      "default": "./dist/api/schemas.js"
    },
    "./api/types": {
      "types": "./dist/api/types.d.ts",
      "default": "./dist/api/types.js"
    },
    "./api/client": {
      "types": "./dist/api/client.d.ts",
      "default": "./dist/api/client.js"
    }
  },
  "main": "./dist/api/routes.js",
  "types": "./dist/api/routes.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@wearly/tsconfig": "workspace:*",
    "typescript": "6.0.3"
  }
}
