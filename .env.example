# API base URL used by the web app (server-side) and the mobile app.
# In production set NEXT_PUBLIC_API_URL to the web origin (not the API URL)
# so the browser auth client calls /api/* on the same origin as the page;
# the Next.js rewrite (API_PROXY_URL) forwards it to the API host.
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Production-only: URL of the NestJS API for the Next.js rewrite.
# Set on Vercel so /api/* is proxied to the API host and the auth cookie
# stays on the web origin. Leave unset in local dev.
API_PROXY_URL=

# Port the NestJS API listens on.
PORT=4000

# ---------------------------------------------------------------------------
# Auth stack (Supabase Postgres + Better Auth) — docs/auth-and-database.md
# ---------------------------------------------------------------------------

# Supabase Postgres connection string.
# Use the session pooler (port 5432) for IPv4-only environments.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Better Auth — generate with `npx @better-auth/cli secret`.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000

# Web origin used for CORS, trusted origins and invite links.
WEB_ORIGIN=http://localhost:3000

# Resend transactional email (verification, admin invites).
# RESEND_API_KEY needs a verified sending domain in Resend; EMAIL_FROM must be
# an address on that domain. The shared onboarding@resend.dev sender only
# reaches the Resend account owner's inbox. Without a key the API prints
# verification codes to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Wearly <no-reply@your-verified-domain>"
# Optional Reply-To for transactional mail.
RESEND_REPLY_TO=

# Optional overrides for transactional email footer links and social icons.
# Defaults fall back to WEB_ORIGIN paths and the Wearly homepage.
EMAIL_PRIVACY_URL=
EMAIL_TERMS_URL=
EMAIL_HELP_URL=
EMAIL_INSTAGRAM_URL=
EMAIL_X_URL=
EMAIL_WEBSITE_URL=
EMAIL_SUPPORT_ADDRESS=
EMAIL_ASSET_BASE_URL=

# OAuth.
# Google mobile sign-in uses the native Google Sign-In SDK: the app mints an
# ID token (audience = the client id below) and the API verifies it against
# Google's JWKS — no secret involved. GOOGLE_CLIENT_ID must equal the app's
# EXPO_PUBLIC_GOOGLE_CLIENT_ID (apps/mobile/.env); a Web-application client
# ID is the documented audience (its secret stays unused). Facebook uses the
# browser code flow and needs both ID + secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Google client ID for the mobile native sign-in (ID-token audience; must
# match GOOGLE_CLIENT_ID above). EXPO_PUBLIC_* is inlined at build time by
# Expo from apps/mobile/.env — set it there (next to EXPO_PUBLIC_API_URL).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Profile — support and legal destinations (set in apps/mobile/.env).
# EXPO_PUBLIC_* is inlined at build time by Expo. Leave unset to omit the
# corresponding row on Profile — no placeholder link is ever shown.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# Initial super_admin seed (run: bun run --cwd apps/api db:seed:super-admin).
# Rotate ADMIN_PASSWORD after the first login. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
